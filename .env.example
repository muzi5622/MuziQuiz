PORT=3000
DATA_DIR=./data
# Set/reset the host password locally with npm run setup:host.
# Passwords are stored only as salted hashes in the database, never here.
# Optional SHA-256 hash of the private reserved-name claim code. Keep the real
# value in the ignored local .env, never in frontend code or exported quizzes.
# RESERVED_JOIN_CODE_HASH=
# Players one device (IP address) may create per session. Default 2; the host laptop is exempt.
# MAX_PLAYERS_PER_DEVICE=2
